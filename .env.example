# Copy this file to .env and fill in your own local values.
# Never commit .env — it contains real credentials.

APP_ENV=local
APP_URL=http://localhost/PostCard/public
APP_TIMEZONE=Europe/Copenhagen


DB_HOST=localhost
DB_PORT=3306
DB_NAME=postcard
DB_USER=postcard_app
DB_PASS=change_me

CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=change_me

# Mail: "log" writes mails to storage/logs/mail.log (local), "smtp" really sends them (Simply)
MAIL_MODE=log
MAIL_HOST=websmtp.simply.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change_me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=PostCard
